#include <MFRC522.h>
#include <SPI.h>
#include <RobotixInnoBot.h>
MFRC522 rfid(10, 9);  //ss,rst
RobotixInnoBot bot;
MFRC522::MIFARE_Key key;

#define btn1 PIN_BTN_1
#define btn2 PIN_BTN_2
#define btn3 PIN_BTN_3
#define btn4 PIN_BTN_4

byte boss_uid[4] = { 0x27, 0xa4, 0xf5, 0x05 };
byte employe_uid[3][4] = { 0x96, 0xff, 0x19, 0x6a };

void setup() {
  bot.begin();
  SPI.begin();
  rfid.PCD_Init();
  for (int i = 0; i < 6; i++) {
    key.keyByte[i] = 0xff;
  }
  bot.clearLCD();
}

void loop() {
  bot.drawString(0, 0, "Enter Card", FONT_SMALL);
  if (!rfid.PICC_IsNewCardPresent()) return;
  if (!rfid.PICC_ReadCardSerial()) return;
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
  if (whoISthat() == "boss") setting();
  else if (whoISthat() == "employee") open_door();
  else alarm();
}

String whoISthat() {
  String client;
  bool correct = false;
  for (int i = 0; i < 4; i++) {
    if (rfid.uid.uidByte[i] == boss_uid[i]) client = "boss";
    else client = "";
  }
  if (client == "boss") return client;
  for (int id = 0; id < 3; id++) {
    for (int i = 0; i < 4; i++) {
      if (rfid.uid.uidByte[i] == employe_uid[id][i]) client = "employee";  //shoud FIX ID
      else client = "";
    }
  if (client == "employee") return client;

  }

  return "wrong uid";
}

void setting() {
  uint16_t current_time = millis();
  uint16_t last_time = millis();
  int client_ID = 0;
  bool last_btn3 = true;
  char text[20];
  String client_UID = whatISuid(client_ID);
  while (bot.readBTN(PIN_BTN_4) && (current_time - last_time < 10000)) {
    sprintf(text, "ID: %d ", client_ID + 1);
    bot.drawString(0, 0, text, FONT_SMALL);
    client_UID.toCharArray(text, 20);
    bot.drawString(0, 1, "UID:", FONT_SMALL);
    bot.drawString(25, 1, text, FONT_SMALL);

    showLCD();
    current_time = millis();
    bool current_btn3 = bot.readBTN(btn3);
    if (!bot.readBTN(btn1)) {
      set_uid(client_ID);
      current_time = millis();
      last_time = millis();
    } else if (!bot.readBTN(btn2)) {
      rmv_uid(client_ID);
      current_time = millis();
      last_time = millis();

    } else if (current_btn3 != last_btn3) {
      if (current_btn3 == false) {
        current_time = millis();
        last_time = millis();
        client_ID++;
        if (client_ID >= 3) client_ID = 0;
        client_UID = whatISuid(client_ID);
      }
      last_btn3 = current_btn3;
    }
  }
  bot.clearLCD();
}
void open_door() {
  bot.drawString(0, 4, "WELCOME", FONT_NORMAL);
  delay(3000);
  bot.clearLCD();
}
void alarm() {
  bot.drawString(15, 2, "!WARNING!", FONT_NORMAL);
  bot.drawString(0, 3, "Access is Denied.", FONT_SMALL);
  
  delay(3000);
  bot.clearLCD();
}
String whatISuid(int ID) {
  String card_uid = "";
  for (int i = 0; i < 4; i++) {

    card_uid += String(employe_uid[ID][i], HEX);
    card_uid += " ";
  }
  card_uid.toUpperCase();
  bot.clearLCD();
  return card_uid;
}
void showLCD() {
  bot.drawString(0, 3, "sw1 :Change Tag", FONT_SMALL);
  bot.drawString(0, 4, "sw2 :remove tag", FONT_SMALL);
  bot.drawString(0, 5, "sw3 : Next", FONT_SMALL);
  bot.drawString(0, 7, "sw4 : Exit", FONT_SMALL);
}
void set_uid(int ID) {
  bot.clearLCD();
  uint16_t current_time, last_time;
  char text[20];
  bool card_change_check = false;
  sprintf(text, "Set ID%d", ID + 1);
  bot.drawString(0, 0, text, FONT_SMALL);
  delay(500);
  if (check_id(ID)) {
    bot.drawString(20, 1, "WARNING", FONT_NORMAL);
    bot.drawString(0, 2, "This ID is Full!", FONT_SMALL);
    bot.drawString(0, 3, "You want set?", FONT_SMALL);
    bot.drawString(0, 5, "confirm: SW1", FONT_SMALL);
    bot.drawString(0, 6, "cancel: SW4", FONT_SMALL);
    delay(1000);
    current_time = millis();
    last_time = millis();
    while (bot.readBTN(btn4) && (current_time - last_time < 5000)) {
      if (!bot.readBTN(btn1)) {
        bot.clearLCD();
        bot.drawString(0, 4, "Enter Tag to set", FONT_SMALL);
        sprintf(text, "ID: %d", ID);
        bot.drawString(0, 5, text, FONT_SMALL);
        current_time = millis();
        last_time = millis();
        while (!rfid.PICC_IsNewCardPresent() && (current_time - last_time < 5000)) {
          current_time = millis();
        }
        bot.clearLCD();
        if (rfid.PICC_ReadCardSerial()) {
          for (int i = 0; i < 4; i++) {
            employe_uid[ID][i] = rfid.uid.uidByte[i];
          }
          rfid.PICC_HaltA();
          rfid.PCD_StopCrypto1();
          card_change_check = true;
        }
        if (check_id(ID) && card_change_check) {
          bot.drawString(0, 4, "Successful.", FONT_NORMAL);
        } else {
          bot.drawString(0, 4, "Failed.", FONT_NORMAL);
        }
        delay(3000);
        break;
      }
    }
  } else {
    bot.drawString(0, 3, "You want set?", FONT_SMALL);
    bot.drawString(0, 5, "confirm: SW1", FONT_SMALL);
    bot.drawString(0, 6, "cancel: SW4", FONT_SMALL);
    delay(1000);
    current_time = millis();
    last_time = millis();
    while (bot.readBTN(btn4) && (current_time - last_time < 5000)) {
      if (!bot.readBTN(btn1)) {
        bot.clearLCD();
        bot.drawString(0, 4, "Enter Tag to set", FONT_SMALL);
        sprintf(text, "ID: %d", ID);
        bot.drawString(0, 5, text, FONT_SMALL);
        current_time = millis();
        last_time = millis();
        while (!rfid.PICC_IsNewCardPresent() && (current_time - last_time < 5000)) {
          current_time = millis();
        }
        bot.clearLCD();
        if (rfid.PICC_ReadCardSerial()) {
          for (int i = 0; i < 4; i++) {
            employe_uid[ID][i] = rfid.uid.uidByte[i];
          }
          card_change_check = true;
        }
        if (check_id(ID) && card_change_check) {
          bot.drawString(0, 4, "Successful.", FONT_NORMAL);
        } else {
          bot.drawString(0, 4, "Failed.", FONT_NORMAL);
        }
        delay(3000);
        break;
      }
    }
  }
}
bool check_id(int ID) {
  int check = 0;
  for (int i = 0; i < 4; i++) {
    if (employe_uid[ID][i] == 0) check++;
  }
  if (check == 4) return false;  //ID is Empty
  else return true;              //ID is Full
}
void rmv_uid(int ID) {
  bot.clearLCD();
  char text[20];
  sprintf(text, "Removing ID:%d", ID);
  bot.drawString(0, 0, text, FONT_SMALL);
  delay(500);
  bot.drawString(20, 1, "WARNING", FONT_NORMAL);
  sprintf(text, "remove ID:%d?", ID);
  bot.drawString(0, 2, text, FONT_SMALL);
  bot.drawString(0, 3, "confirm :SW1", FONT_SMALL);
  bot.drawString(0, 4, "cancel :SW4", FONT_SMALL);
  uint16_t current_time = millis();
  uint16_t last_time = millis();
  bool state = false;
  while (bot.readBTN(btn4) && (current_time - last_time < 5000)) {
    current_time = millis();

    if (!bot.readBTN(btn1)) {
      for (int i = 0; i < 4; i++) {
        employe_uid[ID][i] = 0;
      }
      state = true;
      break;
    }
  }
  if (state) {
    bot.clearLCD();
    sprintf(text, "ID:%d Removed", ID);
    bot.drawString(0, 4, text, FONT_NORMAL);
  } else {
    bot.clearLCD();
    sprintf(text, "Canceled");
    bot.drawString(15, 4, text, FONT_NORMAL);
  }
  delay(3000);
  bot.clearLCD();
}
